
{
  "manifest_version": 3,
  "name": "Google Sheets Autofill",
  "version": "1.0",
  "description": "Autofill personal details from Google Sheets.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
